# Augur Environment Variables
# Copy to .env and fill in your values

# === API Authentication (optional) ===
# When set, Dashboard + REST API /api/* require Authorization: Bearer <token>.
# WebSocket clients must pass ?token=<same value> (browser) or Authorization header.
# Leave empty for open access. MCP stdio server is unaffected.
AUGUR_API_TOKEN=

# === Multi-user JWT (optional, Dashboard) ===
# When AUGUR_MULTI_USER=1, users register/login at /login; JWT also satisfies /api/* auth.
# Can be combined with AUGUR_API_TOKEN (either credential works).
# AUGUR_MULTI_USER=1
# AUGUR_JWT_SECRET=change-me-in-production

# === Optional market data API keys (Finnhub / Alpha Vantage) ===
# Without these, Augur uses yfinance + Stooq. Configure in Settings or here:
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=

# === Telegram Bot ===
TELEGRAM_TOKEN=your_telegram_bot_token

# === Slack Bot ===
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# === WeChat 个人微信 (GeWeChat - 推荐) ===
GEWECHAT_BASE_URL=http://127.0.0.1:2531/v2/api
GEWECHAT_TOKEN=your_gewechat_token
GEWECHAT_APP_ID=

# === WeChat 企业微信 (WeCom) ===
WECHAT_CORP_ID=your_corp_id
WECHAT_CORP_SECRET=your_corp_secret
WECHAT_AGENT_ID=your_agent_id
WECHAT_TOKEN=your_callback_token
WECHAT_AES_KEY=your_encoding_aes_key
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# === Lark/飞书 ===
LARK_APP_ID=your_app_id
LARK_APP_SECRET=your_app_secret
LARK_VERIFICATION_TOKEN=your_verification_token
LARK_ENCRYPT_KEY=your_encrypt_key
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# === AI Chat LLM Configuration (OpenAI / DeepSeek / Local) ===
# Required to enable the AI Master Chat backend. If unset, chat falls back to mock responses.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom API base URL (e.g. for DeepSeek, OneAPI, or local Ollama)
# Leave empty to use default OpenAI endpoint.
# DeepSeek example: https://api.deepseek.com/v1
# Ollama example: http://localhost:11434/v1
OPENAI_BASE_URL=

# Optional: Override chat model (default: gpt-4o)
# DeepSeek example: deepseek-chat
AUGUR_CHAT_MODEL=

# Optional: Max response tokens (default: 1024)
AUGUR_CHAT_MAXTOK=1024

